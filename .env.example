# Copy this to .env and fill in values. Never commit .env.
#
# NOTE: Ports are no longer configured here.
#   - Docker service ports (MySQL, Redis, Piston) are assigned randomly by Docker
#     and discovered at runtime via `docker compose port`.
#   - App ports (Flask, UI, logging) are allocated as free ports by `slbp server run`
#     and written to .slbp-server.json; use `slbp ui open` to open the browser.

# Redis host (port is discovered automatically via docker compose)
REDIS_HOST=localhost

# Flask secret key -- change this to something random in any real deployment
SECRET_KEY=change-me

# Gmail channel integration
# These values are required when system.channels.email.enabled is true.
# The service-account private key remains at credentials/service-account-key.json;
# never place private-key contents in this file.
GMAIL_MAILBOX_EMAIL=service@example.test
GMAIL_ALIAS_EMAIL=assistant@example.test
GMAIL_GOOGLE_CLOUD_PROJECT_ID=example-mail-project
GMAIL_PROCESSOR_SERVICE_ACCOUNT_EMAIL=mail-processor@example-mail-project.iam.gserviceaccount.com
GMAIL_PUBSUB_TOPIC_RESOURCE=projects/example-mail-project/topics/gmail-notifications
GMAIL_PUBSUB_SUBSCRIPTION_RESOURCE=projects/example-mail-project/subscriptions/gmail-notifications-webhook
GMAIL_PUSH_SERVICE_ACCOUNT_EMAIL=gmail-push-invoker@example-mail-project.iam.gserviceaccount.com
GMAIL_PUSH_AUDIENCE=https://agent.example.test/webhooks/gmail
